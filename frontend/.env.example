# Copy to .env.local (gitignored) or inject via Amplify build.
# Set VITE_PREVIEW_MODE=true to use in-memory fixtures and bypass Cognito —
# handy for local UX review before the backend is deployed.
VITE_PREVIEW_MODE=false
VITE_AWS_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_DOMAIN=your-prefix.auth.us-east-1.amazoncognito.com
VITE_COGNITO_REDIRECT_SIGNIN=http://localhost:5173/callback
VITE_COGNITO_REDIRECT_SIGNOUT=http://localhost:5173/
VITE_API_BASE_URL=
