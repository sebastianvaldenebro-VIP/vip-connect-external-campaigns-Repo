{
  "name": "vip-connect-external-campaigns",
  "version": "0.1.0",
  "private": true,
  "description": "External Outbound Campaigns for Amazon Connect — Redis-driven real-time dialer feeder",
  "scripts": {
    "build": "tsc -p infra",
    "watch": "tsc -p infra -w",
    "synth": "cdk synth",
    "diff": "cdk diff",
    "deploy": "cdk deploy --all",
    "deploy:data": "cdk deploy VipExternalCampaignsData",
    "deploy:feeder": "cdk deploy VipExternalCampaignsFeeder",
    "destroy": "cdk destroy --all",
    "test:infra": "jest --config infra/jest.config.js",
    "test:feeder": "cd services/feeder && python -m pytest tests/ -v",
    "lint": "eslint 'infra/**/*.ts'",
    "format": "prettier --write 'infra/**/*.ts'"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.12",
    "aws-cdk": "^2.170.0",
    "aws-cdk-lib": "^2.170.0",
    "constructs": "^10.3.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "ts-node": "^10.9.2",
    "typescript": "~5.4.5",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5"
  },
  "dependencies": {}
}
