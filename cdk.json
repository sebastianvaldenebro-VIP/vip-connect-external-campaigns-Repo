    ],
    "cognitoLogoutUrls": [
      "http://localhost:5173/",
      "https://dprtjww5c9892.cloudfront.net/"
    ],
    "corsAllowOrigins": [
      "http://localhost:5173",
      "https://dprtjww5c9892.cloudfront.net"
    ]
