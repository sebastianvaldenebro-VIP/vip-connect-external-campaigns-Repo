{
  "app": "npx ts-node --prefer-ts-exts infra/bin/app.ts",
  "watch": {
    "include": ["infra/**/*.ts"],
    "exclude": ["node_modules", "cdk.out", "**/*.d.ts", "services/**"]
  },
  "context": {
    "@aws-cdk/aws-lambda:recognizeLayerVersion": true,
    "@aws-cdk/core:checkSecretUsage": true,
    "@aws-cdk/aws-iam:minimizePolicies": true,
    "@aws-cdk/core:validateSnapshotRemovalPolicy": true,
    "@aws-cdk/aws-dynamodb:retainTableReplica": true,

    "_comment_env": "Fill these before running 'cdk deploy'",
    "awsAccountId": "165505826690",
    "awsRegion": "us-east-1",
    "connectInstanceId": "6b3f17ba-68a4-472a-9b20-db1991507009",

    "_comment_vpc": "Matches existing connectcampaignRedisSub VPC (discovered from get-function-configuration)",
    "vpcId": "vpc-0d32b420acc84d370",
    "privateSubnetIds": ["subnet-06c7669b5e3e0e814", "subnet-088367ac9fc0a2fec"],
    "lambdaSecurityGroupId": "sg-01d54d29c2a4785f1",

    "_comment_redis": "ElastiCache Redis. Set redisPasswordSecretArn to the Secrets Manager ARN after enabling AUTH on the cluster (finding #003). Leave empty for VPC-isolation-only environments.",
    "redisHost": "master.prod-medwork-api.jrdc0s.use1.cache.amazonaws.com",
    "redisPort": "6379",
    "redisPasswordSecretArn": "",

    "_comment_app": "Application constants",
    "team": "BASIC_TEAM",
    "feederScheduleMinutes": "5",
    "auditRetentionYears": "6",

    "_comment_iam": "Org-mandated permission boundary — required to CreateRole",
    "permissionsBoundaryName": "EngineeringPermissionBoundary",

    "_comment_progressive_dialer": "Progressive Branded Dialer — reuses alias/prod/external-campaigns/data CMK (same account/system scope). firstOrionSecretArn = vip/firstorion/credentials in Secrets Manager.",
    "progressiveDialerDataKeyArn": "arn:aws:kms:us-east-1:165505826690:key/df585888-2f49-4de0-9cba-14803fda63f0",
    "firstOrionSecretArn": "arn:aws:secretsmanager:us-east-1:165505826690:secret:vip/firstorion/credentials-FvWzcj",

    "_comment_admin_ui": "VIP Admin UI config — Customer Profiles + Cognito",
    "profilesDomainName": "amazon-connect-vipmedicalgroup",
    "cognitoDomainPrefix": "vip-admin-ui-165505826690",
    "cognitoCallbackUrls": [
      "http://localhost:5173/callback",
      "https://dprtjww5c9892.cloudfront.net/callback"
    ],
    "cognitoLogoutUrls": [
      "http://localhost:5173/",
      "https://dprtjww5c9892.cloudfront.net/"
    ],
    "corsAllowOrigins": [
      "http://localhost:5173",
      "https://dprtjww5c9892.cloudfront.net"
    ]
  }
}
